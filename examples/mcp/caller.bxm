<bx:script>
	/**
	 * Call a tool on the MCP server
	 */
	function callToolAction( required struct requestBody, required any mcpClient ) {
		var toolName = requestBody.tool ?: "";
		var params = requestBody.params ?: {};

		if ( !toolName.len() ) {
			writeOutput( jsonSerialize( {
				success: false,
				error: "Tool name is required"
			} ) );
			return;
		}

		var result = mcpClient.send( toolName, params );

		writeOutput( jsonSerialize( {
			success: true,
			result: result
		} ) );
	}

	/**
	 * Call a prompt on the MCP server
	 */
	function callPromptAction( required struct request, required any mcpClient ) {
		var promptName = request.prompt ?: "";
		var params = request.params ?: {};

		if ( !promptName.len() ) {
			writeOutput( jsonSerialize( {
				success: false,
				error: "Prompt name is required"
			} ) );
			return;
		}

		var result = mcpClient.getPrompt( promptName, params );

		writeOutput( jsonSerialize( {
			success: true,
			result: result
		} ) );
	}

	/**
	 * Build the local MCP endpoint URL for a server instance.
	 */
	function buildServerUrl( required string serverName ) {
		var requestPort = cgi.keyExists( "server_port" ) ? cgi.server_port : 9090;
		var baseUrl = "http://localhost:#requestPort#/mcp/mcp.bxm";

		if ( arguments.serverName == "default" ) {
			return baseUrl;
		}

		return "#baseUrl#/#urlEncodedFormat( arguments.serverName )#";
	}

	/**
	 * Get MCP server information and statistics
	 */
	function getServerInfoAction() {
		var servers = [];
		var requestPort = cgi.keyExists( "server_port" ) ? cgi.server_port : 9090;

		if ( application.keyExists( "mcpServer" ) ) {
			var mcpSrv = application.mcpServer;
			var stats = mcpSrv.getStats();
			var serverName = mcpSrv.getServerName();

			servers = [ {
				name: serverName,
				description: mcpSrv.getDescription(),
				version: mcpSrv.getVersion(),
				toolCount: mcpSrv.tools.len(),
				promptCount: mcpSrv.prompts.len(),
				status: "Running",
				requestCount: stats.keyExists( "totalRequests" ) ? stats.totalRequests : 0,
				errorCount: stats.keyExists( "errorCount" ) ? stats.errorCount : 0,
				stats: stats,
				isDefault: serverName == "default",
				port: requestPort,
				url: buildServerUrl( serverName )
			} ];
		}

		writeOutput( jsonSerialize( {
			success: true,
			servers: servers
		} ) );
	}

	if ( url.keyExists( "ajax" ) || cgi.request_method == "POST" ) {
		try {
			requestBody = jsonDeserialize( getHttpRequestData( true ).content.toString() );
		} catch ( any e ) {
			writeOutput( jsonSerialize( {
				success: false,
				error: "Failed to parse request: " & e.message
			} ) );
			abort;
		}

		mcpClient = MCP( buildServerUrl( "default" ) );
		action = requestBody.action ?: "";

		switch ( action ) {
			case "callTool":
				callToolAction( requestBody, mcpClient );
				break;

			case "callPrompt":
				callPromptAction( requestBody, mcpClient );
				break;

			case "getServerInfo":
				getServerInfoAction();
				break;

			default:
				writeOutput( jsonSerialize( {
					success: false,
					error: "Unknown action: " & action
				} ) );
		}

		abort;
	}
</bx:script>