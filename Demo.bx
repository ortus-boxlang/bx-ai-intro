/**
 * BoxLang AI Module — Interactive Demo Runner
 *
 * Navigate with ↑ ↓ arrows, press Enter to run an example, q to quit.
 * Run with: boxlang Demo.bx
 */
class {

	// ── ANSI codes ────────────────────────────────────────────────────────────
	variables.E       = char( 27 )
	variables.RESET   = char( 27 ) & "[0m"
	variables.BOLD    = char( 27 ) & "[1m"
	variables.DIM     = char( 27 ) & "[2m"
	variables.CYAN    = char( 27 ) & "[36m"
	variables.BCYAN   = char( 27 ) & "[96m"
	variables.YELLOW  = char( 27 ) & "[33m"
	variables.BYELLOW = char( 27 ) & "[93m"
	variables.GREEN   = char( 27 ) & "[32m"
	variables.BGREEN  = char( 27 ) & "[92m"
	variables.BLUE    = char( 27 ) & "[34m"
	variables.BBLUE   = char( 27 ) & "[94m"
	variables.MAGENTA = char( 27 ) & "[35m"
	variables.BWHITE  = char( 27 ) & "[97m"
	variables.RED     = char( 27 ) & "[31m"
	variables.BRED    = char( 27 ) & "[91m"
	variables.BG_BLUE = char( 27 ) & "[44m"
	variables.CLEAR   = char( 27 ) & "[2J" & char( 27 ) & "[H"

	// ── Entry Point ───────────────────────────────────────────────────────────
	function main(){
		var examples = getExamples()
		if( examples.isEmpty() ){
			println( BRED & "  No examples found in the examples/ folder!" & RESET )
			return
		}

		var running = true
		while( running ){
			print( CLEAR )
			showBanner()
			var selected = selectExample( examples )
			if( isNull( selected ) ){
				running = false
			} else {
				runExample( selected )
			}
		}

		print( CLEAR )
		println( "" )
		println( BOLD & BCYAN & "  Thanks for exploring BoxLang AI!  Goodbye! 👋" & RESET )
		println( "" )
	}

	// ── Welcome Banner ────────────────────────────────────────────────────────
	private function showBanner(){
		var sep = CYAN & "  " & repeatString( "═", 56 ) & RESET
		println( sep )
		println( "" )
		println( BOLD & BCYAN & "    ██████╗ ██╗  ██╗       █████╗ ██╗" & RESET )
		println( BOLD & BCYAN & "    ██╔══██╗╚██╗██╔╝      ██╔══██╗██║" & RESET )
		println( BOLD & BCYAN & "    ██████╔╝ ╚███╔╝ █████╗███████║██║" & RESET )
		println( BOLD & BCYAN & "    ██╔══██╗ ██╔██╗ ╚════╝██╔══██║██║" & RESET )
		println( BOLD & BCYAN & "    ██████╔╝██╔╝ ██╗      ██║  ██║██║" & RESET )
		println( BOLD & BCYAN & "    ╚═════╝ ╚═╝  ╚═╝      ╚═╝  ╚═╝╚═╝" & RESET )
		println( "" )
		println( "    " & BOLD & BYELLOW & "BoxLang AI Module" & RESET & DIM & " — Interactive Demo Runner" & RESET )
		println( "    " & DIM & "⚡ Powered by bx-ai | Ortus Solutions" & RESET )
		println( sep )
		println( "  " & DIM & " ↑ ↓  Navigate  ## Jump    Enter -> Run    q -> Quit" & RESET )
	}

	// ── Discover Examples ─────────────────────────────────────────────────────
	private function getExamples(){
		return directoryList( expandPath( "./examples" ), false, "array", "*.bxs" )
			.sort()
			.map( ( f ) =>{
			var fileName = listLast( f, "/\" )
			// Strip leading digits+dash and extension to build a human label
			var name = fileName
				.reReplace( "^\d+-?", "" )
				.reReplace( "[-_]", " ", "all" )
				.reReplace( "\.(bxs|bx)$", "" )
				.trim()
			// Title-case
			name = name
				.listToArray( " " )
				.map( w => w.len() ? w.left( 1 ).uCase() & w.right( w.len() - 1 ) : "" )
				.toList( " " )
			var num = fileName.reReplace( "^(\d+).*", "\1" )
			return {
				"label"    : num & " — " & name,
				"fileName" : fileName,
				"path"     : f
			}
		} )
	}

	// ── Interactive Arrow-Key Selection ───────────────────────────────────────
	private function selectExample( required array examples ){
		var selected = 1
		var running  = true
		var tty      = ""
		var scrollTop = 1
		var maxVisibleRows = 10
		var numInput = ""

		setRawMode( true )

		try {
			tty = createObject( "java", "java.io.FileInputStream" ).init( "/dev/tty" )
			// Draw initial menu
			drawMenu( examples, selected, scrollTop, maxVisibleRows )

			while( running ){
				var key = readKey( tty )

				switch( key ){
					case "UP":
						numInput = ""
						if( selected > 1 ){
							selected--
							if( selected < scrollTop ) scrollTop = selected
							drawMenu( examples, selected, scrollTop, maxVisibleRows )
						}
						break
					case "DOWN":
						numInput = ""
						if( selected < examples.len() ){
							selected++
							if( selected > scrollTop + maxVisibleRows - 1 ){
								scrollTop = selected - maxVisibleRows + 1
							}
							drawMenu( examples, selected, scrollTop, maxVisibleRows )
						}
						break
					case "ENTER":
						if( len( numInput ) ){
							var demoNum = val( numInput )
							var found = jumpToDemo( examples, demoNum )
							if( found > 0 ){
								selected = found
								// Adjust scroll to show selected
								if( selected < scrollTop ) scrollTop = selected
								if( selected > scrollTop + maxVisibleRows - 1 ){
									scrollTop = selected - maxVisibleRows + 1
								}
								drawMenu( examples, selected, scrollTop, maxVisibleRows )
								numInput = ""
							}
						} else {
							running = false
						}
						break
					case "Q":
						if( !isSimpleValue( tty ) ) tty.close()
						setRawMode( false )
						return null
					default:
						// Handle numeric input
						if( key.reFind( "^\d$" ) ){
							numInput &= key
							// Limit to 2 digits
							if( len( numInput ) > 2 ){
								numInput = right( numInput, 2 )
							}
						} else if( key == "BACKSPACE" || key == chr( 127 ) ){
							numInput = left( numInput, max( 0, len( numInput ) - 1 ) )
						}
				}
			}
		} finally {
			if( !isSimpleValue( tty ) ) tty.close()
			setRawMode( false )
		}

		return examples[ selected ]
	}

	// ── Jump to Demo by Number ────────────────────────────────────────────────
	private function jumpToDemo( required array examples, required numeric demoNum ){
		for( var i = 1; i <= examples.len(); i++ ){
			var num = examples[ i ].label.reReplace( "^(\d+).*", "\1" )
			if( val( num ) == demoNum ){
				return i
			}
		}
		return 0
	}

	// ── Render Menu Lines ─────────────────────────────────────────────────────
	private function drawMenu( required array examples, required numeric selected, required numeric scrollTop, required numeric maxVisible ){
		var output = ""
		var menuStartRow = 15
		var scrollBottom = min( scrollTop + maxVisible - 1, examples.len() )

		// Move cursor to the menu start row
		output = E & "[" & menuStartRow & ";1H"

		for( var i = scrollTop; i <= scrollBottom; i++ ){
			output &= E & "[2K"   // clear entire line
			if( i == selected ){
				output &= "  " & BG_BLUE & BOLD & BWHITE & "▶  " & examples[ i ].label & "  " & RESET
			} else {
				output &= "  " & DIM & "   " & examples[ i ].label & RESET
			}
			if( i < scrollBottom ){
				output &= E & "[1E"   // move to beginning of next line
			}
		}

		// Clear remaining rows in the viewport
		for( var j = scrollBottom + 1; j <= scrollTop + maxVisible - 1; j++ ){
			output &= E & "[1E" & E & "[2K"
		}

		print( output )
	}

	// ── Read a Single Keypress from /dev/tty ──────────────────────────────────
	private function readKey( required tty ){
		var b1 = tty.read()

		if( b1 == 27 ){
			var b2 = tty.read()
			if( b2 == 91 ){   // CSI '['
				var b3 = tty.read()
				if( b3 == 65 ) return "UP"
				if( b3 == 66 ) return "DOWN"
				if( b3 == 67 ) return "RIGHT"
				if( b3 == 68 ) return "LEFT"
			}
			return "ESC"
		}
		// Enter
		if( b1 == 13 || b1 == 10 ) return "ENTER"
		// Backspace
		if( b1 == 127 ) return "BACKSPACE"
		// q / Q / Ctrl-C
		if( b1 == 113 || b1 == 81 || b1 == 3 ) return "Q"
		// Return all other characters as-is (including digits)
		return char( b1 )
	}

	// ── Toggle Raw Terminal Mode ──────────────────────────────────────────────
	private function setRawMode( required boolean raw ){
		var cmd = raw
			? "stty raw -echo < /dev/tty"
			: "stty -raw echo < /dev/tty"
		createObject( "java", "java.lang.Runtime" )
			.getRuntime()
			.exec( javaCast( "String[]", [ "sh", "-c", cmd ] ) )
			.waitFor()
	}

	// ── Run Selected Example ──────────────────────────────────────────────────
	private function runExample( required struct example ){
		print( CLEAR )

		var titlePad = max( 0, 44 - example.label.len() )
		var filePad  = max( 0, 48 - example.fileName.len() )

		println( BOLD & CYAN & "  ┌" & repeatString( "─", 52 ) & "┐" & RESET )
		println( BOLD & CYAN & "  │  " & RESET & BOLD & BYELLOW & "Running: " & example.label & repeatString( " ", titlePad ) & RESET & BOLD & CYAN & "  │" & RESET )
		println( BOLD & CYAN & "  │  " & RESET & DIM & example.fileName & repeatString( " ", filePad ) & RESET & BOLD & CYAN & "│" & RESET )
		println( BOLD & CYAN & "  └" & repeatString( "─", 52 ) & "┘" & RESET )
		println( "" )

		// Run boxlang via shell so it inherits the login PATH
		var jList = createObject( "java", "java.util.ArrayList" ).init()
		jList.add( "sh" )
		jList.add( "-c" )
		jList.add( "boxlang " & example.path )

		var pb = createObject( "java", "java.lang.ProcessBuilder" ).init( jList )
		pb.inheritIO()
		pb.start().waitFor()

		println( "" )
		println( "  " & DIM & repeatString( "─", 52 ) & RESET )
		println( "  " & BOLD & BGREEN & "✓ Done!  Press Enter to return..." & RESET )

		// Block until Enter (reads from /dev/tty so stdin passthrough doesn't interfere)
		var tty = createObject( "java", "java.io.FileInputStream" ).init( "/dev/tty" )
		try {
			while( true ){
				var b = tty.read()
				if( b == 13 || b == 10 || b == 113 || b == 81 || b == 3 ) break
			}
		} finally {
			tty.close()
		}
	}

}