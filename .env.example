# BoxLang Custom Configuration
BOXLANG_CONFIG=./config/boxlang.json
# API KEYS
OPENAI_API_KEY=your-api-key
DEEPSEEK_API_KEY=your-api-key
GEMINI_API_KEY=your-api-key
GROK_API_KEY=your-api-key
GROQ_API_KEY=your-api-key
PERPLEXITY_API_KEY=your-api-key
CLAUDE_API_KEY=your-api-key
OPENROUTER_API_KEY=your-api-key
MISTRAL_API_KEY=your-api-key
HUGGINGFACE_API_KEY=your-api-key
VOYAGE_API_KEY=your-api-key
COHERE_API_KEY=your-api-key
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
AWS_SESSION_TOKEN=your-session-token #Only needed with AWS SSO
AWS_REGION=your-test-region
# Bedrock long-term API key (bearer auth) — alternative to the AWS keys above.
# See examples/40-bedrock.bxs. Only used when no AWS access key is resolved.
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-bearer-token

# Local AI infrastructure (see docker-compose.yml — docker compose up -d)
OLLAMA_BASE_URL=http://localhost:11434
CHROMA_BASE_URL=http://localhost:8000
QDRANT_BASE_URL=http://localhost:6333
